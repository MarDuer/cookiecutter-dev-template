root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

{% if cookiecutter.project_type in ["python_cli", "python_library"] -%}
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100
{%- endif %}

{% if cookiecutter.project_type == "c_tricore" -%}
[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 120
{%- endif %}

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.md]
max_line_length = off

[Makefile]
indent_style = tab
